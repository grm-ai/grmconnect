# ── Copy to .env on the EC2 box and fill in real values ──────────────────────
# This matches the ACTUAL production setup (SQLite, not Postgres — the
# backend/.env.example in this repo is stale/aspirational and does not
# reflect what's really deployed).

ENV=production

# ─── Database (SQLite file inside the api_data volume) ───────────────────────
DATABASE_URL=sqlite+aiosqlite:////app/data/leadpilot.db
SYNC_DATABASE_URL=sqlite:////app/data/leadpilot.db

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Also used to sign/verify JWTs (see app/security.py) — keep this identical to
# whatever is currently set on Railway so existing user sessions/API keys don't
# get invalidated on cutover.
API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://grmconnect.com,https://www.grmconnect.com

# ─── AI keys ──────────────────────────────────────────────────────────────────
# Leave these blank — the app doesn't actually read them. Each user's own Gemini/
# Anthropic key is stored per-user in sessions/user_settings/{user_id}.json
# (see app/routes/settings_route.py), which is migrated as part of the sessions
# volume (DEPLOY.md step 4), not set here.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=/app/logs
SESSION_DIR=/app/sessions

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=LeadPilot AI
APP_VERSION=1.0.0
DEBUG=false
